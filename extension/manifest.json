{
  "manifest_version": 3,
  "minimum_chrome_version": "130",
  "name": "Margin",
  "version": "0.1.0",
  "description": "Discuss passages beside their source in web pages and PDFs.",
  "permissions": [
    "storage",
    "tabs",
    "sidePanel",
    "offscreen",
    "contextMenus",
    "nativeMessaging"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*",
        "file:///*"
      ],
      "js": [
        "brand.js",
        "anchors.js",
        "client.js",
        "passage-ui.js",
        "conversation.js",
        "image-capture.js",
        "discussion-host.js",
        "pdf/native-entry.js",
        "content.js"
      ],
      "run_at": "document_end"
    }
  ],
  "action": {
    "default_title": "Margin \u00b7 Think beside the text",
    "default_icon": {
      "16": "icons/margin-16.png",
      "32": "icons/margin-32.png",
      "48": "icons/margin-48.png",
      "128": "icons/margin-128.png"
    }
  },
  "icons": {
    "16": "icons/margin-16.png",
    "32": "icons/margin-32.png",
    "48": "icons/margin-48.png",
    "128": "icons/margin-128.png"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "options_page": "options.html",
  "key": ""
}
