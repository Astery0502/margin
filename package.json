{
  "name": "margin",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.19"
  },
  "scripts": {
    "build": "node scripts/build.js",
    "check:reader": "node checks/reader.mjs",
    "test": "node --test checks/*.test.mjs",
    "check:discussions": "node checks/discussions.mjs",
    "check:files": "node checks/local-files.mjs",
    "check:dictation": "node checks/dictation.mjs",
    "check": "npm run build && npm test && npm run check:reader && npm run check:discussions && npm run check:files && npm run check:dictation",
    "build:mac": "npm run build && node scripts/build-connect.js",
    "check:connect": "node checks/connect.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "esbuild": "0.28.2"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "1.6.0",
    "@earendil-works/pi-ai": "1.6.0",
    "@earendil-works/pi-schema": "1.6.0",
    "@huggingface/transformers": "3.8.1",
    "dompurify": "^3.4.16",
    "idb": "8.0.3",
    "katex": "^0.19.0",
    "marked": "^18.0.14",
    "pdfjs-dist": "6.4.299"
  }
}
